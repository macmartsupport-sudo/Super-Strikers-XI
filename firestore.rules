rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check and connection test endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // Cricket jersey orders collection
    match /jersey_orders/{orderId} {
      allow read, write: if true;
    }

    // Team and collection settings
    match /team_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
